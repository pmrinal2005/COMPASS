# Copy to backend/.env — every key is optional. With no SERPAPI_KEY the engine runs in Demo Mode (0 credits).
SERPAPI_KEY=
# DEMO_MODE=true            # force demo even when a key is present
SESSION_CREDIT_BUDGET=30
EXPENSIVE_FANOUT_THRESHOLD=8
MAX_REPLANS=2
CONFIDENCE_THRESHOLD=0.62

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
RESEND_FROM=COMPASS <onboarding@resend.dev>
NOTIFY_EMAIL_TO=

PLAYWRIGHT_ENABLED=true
FRONTEND_ORIGINS=*
CRON_SECRET=change-me
