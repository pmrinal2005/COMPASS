{
  "id": "research_seo",
  "name": "Research & IP Fabric · SEO & AI-Visibility Tracker",
  "ecosystem": "C",
  "lens": "pro",
  "description": "Track where a domain ranks for a keyword across Google, Bing, DuckDuckGo, Yahoo, Yandex, Baidu and Naver, and whether it is cited by Google AI Mode / AI Overview; flags rank-drop anomalies.",
  "keywords": ["seo", "serp", "rank", "ranking", "rankings", "visibility", "keyword", "keywords", "backlink", "search engines", "ai overview", "ai mode", "citations", "cited", "share of voice", "organic", "track"],
  "examples": ["Track SEO visibility of serpapi.com for \"google search api\" across search engines", "Where does stripe.com rank for 'payment gateway api' and is it cited by AI Mode?"],
  "slots": {
    "keyword": {"type": "text", "default": "google search api"},
    "domain": {"type": "domain", "default": "serpapi.com"},
    "market": {"type": "country", "default": "us"}
  },
  "engines": [
    {"engine": "google", "category": "serp", "purpose": "Google organic (+ AI Overview page_token)", "params": {"q": "{keyword}", "gl": "{gl}", "hl": "{hl}"}},
    {"engine": "bing", "category": "serp", "purpose": "Bing organic", "params": {"q": "{keyword}", "cc": "{gl}", "mkt": "{mkt}"}},
    {"engine": "duckduckgo", "category": "serp", "purpose": "DuckDuckGo organic", "params": {"q": "{keyword}", "kl": "{kl}"}},
    {"engine": "yahoo", "category": "serp", "purpose": "Yahoo! organic", "params": {"p": "{keyword}"}},
    {"engine": "google_ai_mode", "category": "ai_citation", "purpose": "Google AI Mode citations (references[])", "essential": false,
     "params": {"q": "{keyword}", "gl": "{gl}", "hl": "{hl}"}},
    {"engine": "yandex", "category": "serp", "purpose": "Yandex organic (regional)", "essential": false, "params": {"text": "{keyword}", "yandex_domain": "yandex.com"}},
    {"engine": "baidu", "category": "serp", "purpose": "Baidu organic (regional)", "essential": false, "params": {"q": "{keyword}"}},
    {"engine": "naver", "category": "serp", "purpose": "Naver web results (regional)", "essential": false, "params": {"query": "{keyword}", "where": "web"}}
  ],
  "fallback_engines": [
    {"engine": "google", "category": "serp", "purpose": "Re-plan: Google page 2 (start=10, localized)", "params": {"q": "{keyword}", "gl": "{gl}", "hl": "{hl}", "start": "10"}},
    {"engine": "bing", "category": "serp", "purpose": "Re-plan: Bing second page (first=11)", "params": {"q": "{keyword}", "cc": "{gl}", "mkt": "{mkt}", "first": "11"}}
  ],
  "dimensions": {
    "visibility": {"weight": 0.42, "direction": "max", "label": "CTR-weighted visibility"},
    "coverage": {"weight": 0.22, "direction": "max", "label": "Engine coverage"},
    "rank": {"weight": 0.16, "direction": "min", "label": "Avg. position"},
    "ai": {"weight": 0.12, "direction": "max", "label": "AI citations"},
    "risk": {"weight": 0.08, "direction": "min", "label": "Risk (rank drops)"}
  },
  "actions": ["document", "watch", "notify"]
}
